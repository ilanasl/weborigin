# Copy this file to ".env" (in the same folder) and paste your key.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional: which Gemini image model to use.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional: port for the local API server (default 8787).
PORT=8787

# Optional: folder where "Run all" saves generated banners (default: app/output).
# Use an absolute path to save anywhere on your computer, e.g.
# OUTPUT_DIR=/Users/me/Desktop/banners
OUTPUT_DIR=
