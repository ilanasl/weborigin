# Rename this file to ".env" and paste your API key(s) below.
# You can set one or both — the studio lets you pick the engine per run.

# Google Gemini (cheaper) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# OpenAI GPT image (sharper) — get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_key_here

# Claude (reads pasted task cards, writes the prompts, checks finished banners) — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_key_here

# Optional — leave these as they are unless you have a reason to change them.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=high     # low | medium | high  (higher = sharper, pricier)
# CLAUDE_MODEL=claude-opus-5-5
# PORT=8787
# OUTPUT_DIR=./output
# QA_DIR=./output/QA           # where New-task banners are saved for checking, e.g. C:\SPOTOWER\QA
# BACKUP_DIR=./backups          # where saved-banner backups are written (auto). Any folder, e.g. C:\Users\me\BannerBackups
