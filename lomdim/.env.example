# ── לומדים ביחד — משתני סביבה ──
# העתיקו קובץ זה ל־.env.local ומלאו את הערכים (הקובץ .env.local לא נשמר ב-git).

# Supabase — מתוך Project Settings → API בפרויקט ה-Supabase שלכם
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── מצב הרצה קל (מומלץ להתחלה / מקומי בלבד) ──
# אם תמלאו מפתח כאן, האפליקציה תדבר עם Gemini ישירות — בלי צורך לפרוס פונקציית שרת.
# ⚠️ רק להרצה מקומית! אל תפרסו כך לאתר ציבורי (המפתח נחשף). מפתח: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# VITE_GEMINI_MODEL=gemini-2.0-flash

# ── מצב מאובטח (לפרודקשן) ──
# כתובת פונקציית ה-Edge (בדרך כלל <SUPABASE_URL>/functions/v1/gemini). נגזר אוטומטית אם ריק.
VITE_GEMINI_FN_URL=

# ── סודות צד-שרת (NOT exposed to the browser) ──
# מוגדרים ב-Supabase כ-Secrets לפונקציה, לא כאן:
#   supabase secrets set GEMINI_API_KEY=xxxx
# GEMINI_API_KEY נלקח מ-Google AI Studio (חינם): https://aistudio.google.com/apikey
